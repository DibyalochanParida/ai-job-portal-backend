{
  "name": "ai-job-portal-backend",
  "version": "0.1.0",
  "description": "AI-powered job portal API (Express + PostgreSQL + pgvector + Claude)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "reembed": "tsx --env-file-if-exists=.env src/db/reembed.ts",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DibyalochanParida/ai-job-portal-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/DibyalochanParida/ai-job-portal-backend/issues"
  },
  "homepage": "https://github.com/DibyalochanParida/ai-job-portal-backend#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-pgvector": "^0.0.17",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
