{
  "family": "ai-job-portal-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ai-job-portal-ecs-execution",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ai-job-portal-api-task",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "replaced-by-github-actions",
      "essential": true,
      "portMappings": [{ "containerPort": 4000, "protocol": "tcp" }],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "4000" },
        { "name": "TRUST_PROXY", "value": "true" },
        { "name": "DATABASE_SSL", "value": "true" },
        { "name": "RUN_MIGRATIONS", "value": "true" },
        { "name": "STORAGE_DRIVER", "value": "s3" },
        { "name": "S3_BUCKET", "value": "<RESUME_BUCKET_NAME>" },
        { "name": "AWS_REGION", "value": "<AWS_REGION>" },
        { "name": "CORS_ORIGIN", "value": "https://<YOUR_DOMAIN>" },
        { "name": "AI_PROVIDER", "value": "auto" },
        { "name": "EMBEDDINGS_PROVIDER", "value": "auto" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<ACCOUNT_ID>:secret:ai-job-portal/database-url" },
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<ACCOUNT_ID>:secret:ai-job-portal/jwt-secret" },
        { "name": "ANTHROPIC_API_KEY", "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<ACCOUNT_ID>:secret:ai-job-portal/anthropic-api-key" },
        { "name": "VOYAGE_API_KEY", "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<ACCOUNT_ID>:secret:ai-job-portal/voyage-api-key" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://127.0.0.1:4000/api/health >/dev/null || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ai-job-portal-api",
          "awslogs-region": "<AWS_REGION>",
          "awslogs-stream-prefix": "api",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
