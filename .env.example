# Copy to .env and adjust. Every variable is optional for local development.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Set to true behind a load balancer (AWS ALB) so rate limiting sees client IPs.
TRUST_PROXY=false

# PostgreSQL with pgvector, e.g. postgres://jobportal:jobportal@localhost:5432/jobportal
# For zero-setup local dev, the default embedded database is used:
DATABASE_URL=pglite://./.data/pglite
DATABASE_SSL=false
RUN_MIGRATIONS=true

# Required in production: at least 32 random characters (e.g. `openssl rand -base64 48`).
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# --- AI (resume parsing, feedback, NL search, recruiter assistant)
# auto = Claude when ANTHROPIC_API_KEY is set, otherwise the built-in heuristic engine.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Embeddings (job matching + semantic search)
# auto = Voyage AI when VOYAGE_API_KEY is set, otherwise local feature-hashing vectors.
# After changing provider or model run `npm run reembed`.
EMBEDDINGS_PROVIDER=auto
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# --- Resume storage
# local (dev) or s3 (production; credentials from the AWS default chain / ECS task role)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
S3_BUCKET=
AWS_REGION=us-east-1
# Optional: MinIO / LocalStack endpoint for S3-compatible local testing
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Prefix for local-storage download links when the API is on a different origin than the frontend.
PUBLIC_API_URL=

# Password for demo accounts created by `npm run seed` (employer@demo.example, seeker@demo.example).
SEED_DEMO_PASSWORD=DemoPass123!
